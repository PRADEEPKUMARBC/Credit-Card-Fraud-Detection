# -----------------------------------------------------------------
# Normalize line endings
# -----------------------------------------------------------------
# By default, Git stores files with LF inside the repository.
# On checkout, Windows gets CRLF, Linux/Mac get LF. This keeps
# diffs stable regardless of the OS you're using.
# -----------------------------------------------------------------

* text=auto eol=lf

# Explicit text files (force LF)
*.py     text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.gitignore       text eol=lf
*.gitattributes   text eol=lf

# Windows scripts must keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# -----------------------------------------------------------------
# Binary files — never touch line endings
# -----------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.pkl    binary
*.joblib binary
*.csv    binary

# -----------------------------------------------------------------
# Diff rules
# -----------------------------------------------------------------
*.ipynb  diff=jupyternotebook
*.py     diff=python
*.md     diff=markdown